# Copy this file to .env and fill in your values.
# Settings in .env override the defaults in config/settings.py

DATABASE_URL=postgresql://pricing_user:pricing_pass@localhost:5432/pricing_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=300

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=dynamic_pricing

# Guardrails
PRICE_FLOOR_PCT=0.70
PRICE_CEILING_PCT=2.00
MAX_PRICE_CHANGE_PCT=0.30

# API security (optional — leave blank to disable auth)
API_KEY=

# Model artefact paths
MODEL_DIR=models/saved
ELASTICITY_MODEL_PATH=models/saved/elasticity_model.pkl
DEMAND_MODEL_PATH=models/saved/demand_model.pkl
